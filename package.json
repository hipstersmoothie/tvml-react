{
  "name": "tvml-react",
  "version": "0.1.0",
  "description": "A React renderer for Apple TV's TVML / TVMLKit",
  "keywords": [
    "react",
    "react-reconciler",
    "renderer",
    "tvml",
    "tvmlkit",
    "tvjs",
    "tvos",
    "apple-tv"
  ],
  "license": "MIT",
  "author": "Andrew Lisowski <lisowski54@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hipstersmoothie/tvml-react.git"
  },
  "homepage": "https://github.com/hipstersmoothie/tvml-react#readme",
  "bugs": "https://github.com/hipstersmoothie/tvml-react/issues",
  "type": "module",
  "sideEffects": [
    "./dist/polyfills.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "default": "./dist/jsx-dev-runtime.js"
    },
    "./polyfills": {
      "types": "./dist/polyfills.d.ts",
      "default": "./dist/polyfills.js"
    },
    "./simplified-list": {
      "types": "./dist/simplified-list.d.ts",
      "default": "./dist/simplified-list.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "default": "./dist/build.js"
    },
    "./bootstrap/Application.js": "./bootstrap/Application.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "tvml-react": "./bin/tvml-react.js"
  },
  "files": [
    "bin",
    "dist",
    "bootstrap"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "react-reconciler": "^0.33.0"
  },
  "peerDependencies": {
    "esbuild": ">=0.20.0",
    "react": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-reconciler": "^0.33.0",
    "esbuild": "^0.28.0",
    "react": "^19.2.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.26.0"
}
