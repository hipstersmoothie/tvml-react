---
import { render } from "astro:content";

import Site from "../../layouts/Site.astro";
import { entries, hrefOf, slugOf, type DocEntry } from "../../lib/nav";

export async function getStaticPaths() {
  return (await entries("reference")).map((entry) => ({ params: { slug: slugOf(entry) }, props: { entry } }));
}

const { entry } = Astro.props as { entry: DocEntry };
const { Content, headings } = await render(entry);
const kinds = { component: "Component", hook: "Hook", function: "Function", type: "Type", constant: "Constant" };
---

<Site
  title={entry.data.title}
  description={entry.data.abstract}
  active="reference"
  sidebar="reference"
  currentHref={hrefOf(entry)}
  toc={headings}
>
  <p class="eyebrow">
    {entry.data.module ?? "tvml-react"}
    {entry.data.kind && <span class="kind"> · {kinds[entry.data.kind]}</span>}
  </p>
  <h1>{entry.data.title}</h1>
  <p class="abstract">{entry.data.abstract}</p>
  {entry.data.declaration && <pre class="declaration"><code>{entry.data.declaration}</code></pre>}
  <article class="prose"><Content /></article>
</Site>
