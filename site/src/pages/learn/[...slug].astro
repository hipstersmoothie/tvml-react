---
import { render } from "astro:content";

import Site from "../../layouts/Site.astro";
import { entries, hrefOf, slugOf, type DocEntry } from "../../lib/nav";

export async function getStaticPaths() {
  return (await entries("learn")).map((entry) => ({ params: { slug: slugOf(entry) }, props: { entry } }));
}

const { entry } = Astro.props as { entry: DocEntry };
const { Content, headings } = await render(entry);
---

<Site
  title={entry.data.title}
  description={entry.data.abstract}
  active="learn"
  sidebar="learn"
  currentHref={hrefOf(entry)}
  toc={headings}
>
  <p class="eyebrow">Guide</p>
  <h1>{entry.data.title}</h1>
  <p class="abstract">{entry.data.abstract}</p>
  <article class="prose"><Content /></article>
</Site>
