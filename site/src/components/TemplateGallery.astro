---
// Every TVML template as it looks on tvOS: the kitchen-sink example's
// screens, captured by KitchenSinkTests.
const templates = [
  ["stackTemplate", "Rows of shelves, grids and carousels"],
  ["productTemplate", "One item's page"],
  ["listTemplate", "A list with a preview panel"],
  ["catalogTemplate", "Categories beside a grid"],
  ["compilationTemplate", "An album or season"],
  ["searchTemplate", "Search as you type"],
  ["menuBarTemplate", "Tabs"],
  ["showcaseTemplate", "A carousel of large images"],
  ["paradeTemplate", "A list beside an image deck"],
  ["productBundleTemplate", "A bundle of items"],
  ["oneupTemplate", "Fullscreen images, one at a time"],
  ["divTemplate", "Free-form"],
  ["alertTemplate", "A message with buttons"],
  ["descriptiveAlertTemplate", "Long text with buttons"],
  ["formTemplate", "A text field"],
  ["ratingTemplate", "Rate an item"],
  ["loadingTemplate", "A spinner"],
  ["Lockups", "Lockups, overlays, monograms"],
];
---

<div class="gallery">
  {
    templates.map(([name, description]) => (
      <figure>
        <img src={`/screens/${name}.jpg`} alt={`${name} on tvOS`} loading="lazy" />
        <figcaption>
          <code>{name === "Lockups" ? "lockup" : name}</code>
          <span>{description}</span>
        </figcaption>
      </figure>
    ))
  }
</div>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 18px;
    margin: 24px 0;
  }
  figure {
    margin: 0;
  }
  img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 10px;
    border: 1px solid var(--line);
  }
  figcaption {
    display: grid;
    gap: 2px;
    margin-top: 6px;
  }
  figcaption code {
    font: 600 13px var(--mono) !important;
    background: none !important;
    padding: 0 !important;
    color: var(--text);
  }
  figcaption span {
    font-size: 13px;
    color: var(--tertiary);
  }
</style>
